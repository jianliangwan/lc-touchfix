diff --git a/LiveContainer/LCSceneUtils.h b/LiveContainer/LCSceneUtils.h
new file mode 100644
index 0000000..56b61c2
--- /dev/null
+++ b/LiveContainer/LCSceneUtils.h
@@ -0,0 +1,105 @@
+//
+//  LCSceneUtils.h
+//  LiveContainer
+//
+//  Helpers to resolve the *correct* foreground UIWindowScene / key window.
+//
+//  Why this exists:
+//  LiveContainer hosts more than one app scene inside a single process
+//  (multitask virtual/native windows) and also runs multiple LC instances.
+//  On iPhone and single-screen iPads every UIWindowScene shares
+//  UIScreen.mainScreen, so resolving a scene by `connectedScenes.anyObject`,
+//  `.first` or by matching `windowScene.screen == self.screen` picks an
+//  ARBITRARY scene. A guest window / alert window bound to a background or
+//  terminated scene becomes invisible-but-present and swallows every touch,
+//  which is exactly the "app shows but cannot be touched" symptom.
+//
+//  These helpers always prefer the scene the user is actually looking at
+//  (foregroundActive), then a foreground-inactive scene, and only fall back
+//  to a stable, explicit choice. They never use `anyObject` for touch-bearing
+//  windows.
+//
+
+#import <UIKit/UIKit.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+/// The scene the user is currently interacting with. Best choice for any
+/// window that must receive touches (guest windows, confirmation alerts).
+/// - Returns: foregroundActive scene, else foregroundInactive scene, else nil.
+static inline UIWindowScene * _Nullable LCForegroundActiveScene(void) {
+    UIApplication *app = UIApplication.sharedApplication;
+    UIWindowScene *foregroundInactive = nil;
+
+    for (id object in app.connectedScenes) {
+        if (![object isKindOfClass:UIWindowScene.class]) continue;
+        UIWindowScene *scene = (UIWindowScene *)object;
+        if (scene.activationState == UISceneActivationStateForegroundActive) {
+            return scene;
+        }
+        if (!foregroundInactive && scene.activationState == UISceneActivationStateForegroundInactive) {
+            foregroundInactive = scene;
+        }
+    }
+    return foregroundInactive;
+}
+
+/// The key window of the foreground-active scene. Use this instead of
+/// `connectedScenes.anyObject.keyWindow`, which can be a totally different
+/// (background) scene's window on a multi-scene process.
+/// - Returns: key window belonging to the active scene, else nil.
+static inline UIWindow * _Nullable LCActiveSceneKeyWindow(void) {
+    UIWindowScene *scene = LCForegroundActiveScene();
+    if (!scene) return nil;
+    for (UIWindow *window in scene.windows) {
+        if (window.isKeyWindow && !window.hidden) return window;
+    }
+    return nil;
+}
+
+/// Bind `window` to the scene the user is currently looking at. If there is no
+/// active scene yet (very early launch), the window is left unbound and UIKit
+/// will associate it with the scene it is presented from.
+static inline void LCBindWindowToActiveScene(UIWindow *window) {
+    UIWindowScene *scene = LCForegroundActiveScene();
+    if (scene && window.windowScene != scene) {
+        window.windowScene = scene;
+    }
+}
+
+/// Given a `runningLC` value from containerLock.plist, resolve the actual LC
+/// instance URL scheme to jump to.
+///
+/// containerLock stores `lcAppUrlScheme`, which for a multitask guest hosted by
+/// LiveProcess is the bare string `@"liveprocess"` (NOT e.g. `livecontainer2`).
+/// `-stringByDeletingPathExtension` on a bare `@"liveprocess"` is a no-op, so
+/// callers ended up opening `liveprocess://...`, which no installed LC handles.
+/// The host LC scheme lives in the host main bundle's CFBundleURLSchemes; pick
+/// the one matching the `livecontainer*` family.
+static inline NSString * _Nullable LCResolveHostLCScheme(NSString * _Nullable runningLC,
+                                                          NSBundle * _Nullable hostBundle) {
+    if (!runningLC) return nil;
+
+    if (![runningLC hasSuffix:@"liveprocess"]) {
+        return runningLC;
+    }
+
+    // `livecontainer2.liveprocess` -> `livecontainer2` (legitimate dotted form).
+    NSString *stripped = runningLC.stringByDeletingPathExtension;
+    if (![stripped isEqualToString:runningLC] && stripped.length > 0) {
+        return stripped;
+    }
+
+    // Bare `liveprocess`: recover the host app's own scheme.
+    NSArray *urlTypes = hostBundle.infoDictionary[@"CFBundleURLTypes"];
+    for (NSDictionary *type in urlTypes) {
+        for (NSString *scheme in type[@"CFBundleURLSchemes"]) {
+            if ([scheme hasPrefix:@"livecontainer"] && ![scheme hasSuffix:@"liveprocess"]) {
+                return scheme;
+            }
+        }
+    }
+    return nil;
+}
+
+NS_ASSUME_NONNULL_END
