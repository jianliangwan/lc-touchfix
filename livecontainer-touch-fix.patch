+// Restore touch delivery after a window focus / container switch. A guest window
+// whose scene was terminated/disconnected stays visible but receives no touches.
+// When a scene becomes active, repair only genuinely stale bindings: windows
+// with no scene, or whose scene is no longer connected. We intentionally do NOT
+// touch windows on a healthy (even background/hosted) scene — multitask guest
+// scenes are hosted and can legitimately report a background activation state.
+static void LCInstallSceneActivationObserver(void) {
+    static dispatch_once_t onceToken;
+    dispatch_once(&onceToken, ^{
+        [NSNotificationCenter.defaultCenter addObserverForName:UIScene.didActivateNotification
+                                                        object:nil
+                                                         queue:NSOperationQueue.mainQueue
+                                                    usingBlock:^(NSNotification * _Nonnull note) {
+            if (!LCForegroundActiveScene()) return;
+            NSSet *connected = UIApplication.sharedApplication.connectedScenes;
+            for (UIWindow *window in UIApplication.sharedApplication.windows) {
+                if (window.hidden) continue;
+                UIWindowScene *current = window.windowScene;
+                // Only repair a missing scene or a scene iOS has disconnected.
+                BOOL stale = !current || (current && ![connected containsObject:current]);
+                if (!stale) continue;
+                if ([window respondsToSelector:@selector(updateWindowScene)]) {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Warc-performSelector-leaks"
+                    [window performSelector:@selector(updateWindowScene)];
+#pragma clang diagnostic pop
+                }
+            }
+        }];
+    });
+}
